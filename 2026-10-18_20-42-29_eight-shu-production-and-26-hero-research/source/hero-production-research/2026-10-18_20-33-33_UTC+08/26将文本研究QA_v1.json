  "cross_hero_manual_review": [
    {
      "heroes": [
        "张辽",
        "乐进",
        "于禁",
        "张郃",
        "徐晃"
      ],
      "boundary": "五子依次为侧面切后、近身持续压力、驻阵减伤、友军移位、敌人能量抑制；尖翼刀骑/矮壮短枪/方整镇阵/细长转身枪/重斧断路，神相与轮廓不共享。"
    },
    {
      "heroes": [
        "许褚",
        "张飞",
        "典韦"
      ],
      "boundary": "许褚白额重虎、横厚低身、可见蓄力舍防重斩；张飞既定虎形断喝与当前生命压血；典韦巨巫祖影、双短戟、一次部分替伤，不给典韦虎头或真实族属断言。"
    },
    {
      "heroes": [
        "吕蒙",
        "许褚"
      ],
      "boundary": "吴v3已纠正：吕蒙停手整备的收益是单体短缴械，刀击仅普通威力；许褚蓄力收益是高伤且蓄时降防。两者不得重新同化为蓄力高伤+减防。"
    },
    {
      "heroes": [
        "孙策",
        "马超",
        "吕布"
      ],
      "boundary": "吴v2起已纠正：孙策对未曾伤害的新目标接战，奖励换敌；马超既定开局正面骑阵破盾；吕布固定目标正面格挡压制，不给三人同一个开局冲锋。"
    },
    {
      "heroes": [
        "周瑜",
        "陆逊",
        "黄盖",
        "庞统"
      ],
      "boundary": "周瑜一次广域火击；陆逊有限相邻地面火段；黄盖消耗自身盾的短扇火浪；庞统既定少量火印后引燃。不同资源、时空结构和剪影。"
    },
    {
      "heroes": [
        "张角",
        "诸葛亮",
        "郭嘉"
      ],
      "boundary": "张角原地可打断风暴持续伤害；诸葛亮既定布局迟滞后定点雷；郭嘉单敌主动后结算谋记，不用同一雷球法阵。"
    },
    {
      "heroes": [
        "典韦",
        "赵云",
        "张郃",
        "左慈",
        "董卓"
      ],
      "boundary": "典韦部分替伤不反击；赵云既定刺击护救再回锋；张郃直接移动友军；左慈一个不可攻击的幻影替本体挡一次普攻；董卓单敌嘲讽并消耗本战生命上限。共同有防护含义，但触发对象、代价与操作不同。"
    },
    {
      "heroes": [
        "曹操",
        "荀彧",
        "孙权",
        "刘备",
        "华佗",
        "孙尚香"
      ],
      "boundary": "曹操承压积令强化一人下一普攻；荀彧直接补一人能量；孙权把己方可转换攻击增益换盾；刘备既定群体增益治疗；华佗一人治疗并有限清持续伤害；孙尚香伙伴命中后一次补箭。"
    },
    {
      "heroes": [
        "徐晃",
        "贾诩",
        "甘宁",
        "貂蝉"
      ],
      "boundary": "徐晃只压能量恢复；贾诩只禁他人提供的治疗；甘宁移除一个可驱散正增益；貂蝉仅改向一次普攻。资源轴和干预类型互不偷换。"
    },
    {
      "heroes": [
        "袁绍",
        "黄忠",
        "孙尚香"
      ],
      "boundary": "袁绍有限不同敌人各一箭，不把缺额叠单体；黄忠既定远距锁定精射；孙尚香单伙伴一次追随射击。"
    }
  ],
